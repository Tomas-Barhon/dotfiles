# Backups made by install.sh while re-linking
backup/

# Omarchy upgrade / safety backups (left in place, never tracked)
*.bak
*.bak.*
*.omarchy-upgrade-*

# Hypr auto-generated shader symlinks (created by omarchy/aether)
hypr/shaders/

# Aether generated / state files
aether/theme/
aether/custom/
aether/themes/
aether/migration-version
aether/.protocol-handler-installed

# nvim lockfile (rewritten by lazy.nvim on every plugin update)
nvim/lazy-lock.json

# opencode: plugin install artifacts + generated state (managed by installers)
opencode/node_modules/
opencode/package.json
opencode/bun.lock
opencode/package-lock.json
opencode/.oh-my-opencode-slim/

# opencode: skills bundled by the oh-my-opencode-slim installer (re-deployed on update)
opencode/skills/clonedeps/
opencode/skills/codemap/
opencode/skills/deepwork/
opencode/skills/oh-my-opencode-slim/
opencode/skills/reflect/
opencode/skills/simplify/
opencode/skills/verification-planning/
opencode/skills/worktrees/